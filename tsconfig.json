{
    "include": ["src", "vite.config.ts"],
    "compilerOptions": {
        "target": "es2023",
        "lib": ["dom", "dom.iterable", "es2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["vite/client"]
    }
}
